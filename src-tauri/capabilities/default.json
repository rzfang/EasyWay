{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:default",
    "shell:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/.config/labwc/*"
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "labwc-config-reload",
          "cmd": "labwc",
          "args": [ "-r" ]
        }
      ]
    }
  ]
}
