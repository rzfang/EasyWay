{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:default",
    "shell:allow-execute",
    "shell:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/.config/labwc/*"
      ]
    }
  ]
}
